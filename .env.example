API_BASE_URL=https://api.telegram.org
HOOK_ENDPOINT=https://api.thdorsan.com/api/v1/telegram-hook
HOOK_SECRET_TOKEN=
# Token values do not include the "bot" URL prefix. Never commit a real token.
ALLOWED_TOKENS=123456789:replace-with-real-token-at-deploy-time
HOST=0.0.0.0
PORT=5000
GUNICORN_THREADS=8
# Must exceed the longest expected provider upload/read timeout.
GUNICORN_TIMEOUT=1900
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=100

# Optional explicit outbound proxy used only by this service. `socks5h` keeps
# provider DNS resolution on the V2Ray side.
OUTBOUND_PROXY_URL=
OUTBOUND_PROXY_BYPASS_HOSTS=api,localhost,127.0.0.1

# Secure synchronous outbound relay
RELAY_ENABLED=false
RELAY_PATH=/relay
RELAY_KEY=
RELAY_SECRET=
RELAY_CLOCK_SKEW=60
RELAY_CONNECT_TIMEOUT=15
RELAY_READ_TIMEOUT=1800
RELAY_ALLOW_HTTP=false
RELAY_ALLOWED_HOSTS_YOUTUBE=oauth2.googleapis.com,www.googleapis.com
RELAY_ALLOWED_HOSTS_INSTAGRAM=zigzal.app
RELAY_ALLOWED_HOSTS_TELEGRAM=api.telegram.org
RELAY_ALLOWED_HOSTS_WHATSAPP=graph.facebook.com

# Optional legacy Telegram queue. Normal requests are synchronous; a caller
# must send X-Queue-Request: true and this flag must be enabled.
QUEUE_ENABLED=false
QUEUE_DB_PATH=/data/queue.db
MAX_RETRIES=8
WORKER_POLL_INTERVAL=0.1
WORKER_BATCH_SIZE=10

# Rate Limits
RATE_LIMIT_GLOBAL=28
RATE_LIMIT_CHAT_PRIVATE=1
RATE_LIMIT_CHAT_GROUP=20
RATE_LIMIT_CHAT_GROUP_WINDOW=60
